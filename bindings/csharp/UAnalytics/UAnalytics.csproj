<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UAnalytics</RootNamespace>
    <AssemblyName>UAnalytics</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>UAnalytics</PackageId>
    <Version>0.3.1</Version>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>UAnalytics</Product>
    <Description>SPC, process capability, MSA, Weibull, change-point detection — Rust engine with C# bindings.</Description>
    <PackageTags>spc;quality;cpk;gage-rr;weibull;pelt;statistics;ffi</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/u-analytics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/u-analytics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build Configuration -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native library bundling (4 platforms) -->
    <None Include="runtimes/win-x64/native/u_analytics.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/"
          Condition="Exists('runtimes/win-x64/native/u_analytics.dll')" />
    <None Include="runtimes/linux-x64/native/libu_analytics.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/"
          Condition="Exists('runtimes/linux-x64/native/libu_analytics.so')" />
    <None Include="runtimes/osx-x64/native/libu_analytics.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/"
          Condition="Exists('runtimes/osx-x64/native/libu_analytics.dylib')" />
    <None Include="runtimes/osx-arm64/native/libu_analytics.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/"
          Condition="Exists('runtimes/osx-arm64/native/libu_analytics.dylib')" />
  </ItemGroup>

</Project>
